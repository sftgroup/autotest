[Unit]
Description=autotest-web3 — 去中心化测试 MCP Server (EVM + Solana)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/autotest-mcp/autotest-web3
EnvironmentFile=/home/ubuntu/workspace/autotest-mcp/autotest-web3/.env
ExecStart=/usr/bin/python3 /home/ubuntu/workspace/autotest-mcp/autotest-web3/server.py --sse --host 0.0.0.0 --port 8081
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
