[Unit]
Description=autotest-web — 中心化测试 MCP Server (Browser + API + Security)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/autotest-mcp/autotest-web
EnvironmentFile=/home/ubuntu/workspace/autotest-mcp/autotest-web/.env
ExecStart=/usr/bin/python3 /home/ubuntu/workspace/autotest-mcp/autotest-web/server.py --sse --host 0.0.0.0 --port 8082
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
