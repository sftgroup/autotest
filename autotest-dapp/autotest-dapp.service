[Unit]
Description=autotest-dapp — DApp 全链路测试 MCP Server (链 + 前端)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/autotest-mcp/autotest-dapp
EnvironmentFile=/home/ubuntu/workspace/autotest-mcp/autotest-dapp/.env
ExecStart=/usr/bin/python3 /home/ubuntu/workspace/autotest-mcp/autotest-dapp/server.py --sse --host 0.0.0.0 --port 8083
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
